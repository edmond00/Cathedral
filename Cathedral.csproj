<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Console subsystem for development, GUI subsystem for shipped builds.

      A developer wants the diagnostic stream and the CLI driver, both of which need a console.
      A player double-clicking the game wants a game, not a black window filling with log lines.
      The two differ only in a PE subsystem flag, so one property covers it:

          dotnet build                → Exe    (console; the default for everyone)
          dotnet publish -p:Ship=true → WinExe (no console window; what package.ps1 passes)

      Keyed on an explicit Ship property rather than on Configuration, so that building or
      profiling in Release still gives you a console. Shipping is a deliberate act.

      ConsoleAttach rejoins a terminal when a shipped build is launched from one, which is what
      keeps the CLI driver usable against a packaged build.
    -->
    <OutputType Condition="'$(Ship)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(Ship)' != 'true'">Exe</OutputType>

    <!--
      SHIP also compiles out the developer keyboard shortcuts. See Config.Debug.DeveloperKeys:
      the default is baked in here rather than read from a setting, so a shipped build cannot be
      talked into exposing them.
    -->
    <DefineConstants Condition="'$(Ship)' == 'true'">$(DefineConstants);SHIP</DefineConstants>

    <!--
      The game is "Proscribed Palimpsest" to a player and "Cathedral" to everyone working on it.
      Only the shipped executable is renamed, deliberately: run_tests.sh guards the suite with
      `Get-Process -Name Cathedral`, and that guard is what stops a leftover run from racing a new
      one. Renaming the development binary would break it silently — the guard would simply stop
      finding anything, which reads as "all clear".

      No space in the name. A player sees it in a folder listing either way, and every CLI
      invocation (the whole test driver, any future CI) would otherwise need quoting.
    -->
    <AssemblyName Condition="'$(Ship)' == 'true'">ProscribedPalimpsest</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Allow BinaryFormatter for MSAGL's GViewer which uses it to deserialize its own embedded toolbar resources -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <!-- UseWindowsForms is intentionally omitted: it adds implicit global usings that conflict with
         SixLabors.ImageSharp and SixLabors.Fonts. WinForms is referenced explicitly below instead. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Cathedral</RootNamespace>
    <!-- Allow easy package management with central package management -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Exclude deprecated code from build -->
  <ItemGroup>
    <Compile Remove="DEPRECATED\**" />
    <EmbeddedResource Remove="DEPRECATED\**" />
    <None Remove="DEPRECATED\**" />
  </ItemGroup>

  <!--
    Terminal shaders, embedded so there is exactly ONE copy of each.

    They are read from src/terminal/Shaders/ when that folder is present (so a shader can be edited
    without a rebuild) and from the assembly otherwise. `src/` is not in the shipped payload, so a
    package always runs the embedded copy — which is why these were previously duplicated as string
    literals in both renderers, and why one of those duplicates silently drifted: the shipped build
    lost `uGlyphScale` and drew its terminal text at the wrong scale for years. See ShaderSource.

    LogicalName keeps the resource named for the file ("Shaders/terminal.vert") rather than for its
    namespace-mangled path, so the lookup does not move when a folder is renamed. The wildcard means
    a new shader file is embedded the day it is added, with nothing to remember.
  -->
  <ItemGroup>
    <EmbeddedResource Include="src\terminal\Shaders\*">
      <LogicalName>Shaders/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- NuGet Package References -->
  <ItemGroup>
    <PackageReference Include="Catalyst" Version="26.3.60" />
    <PackageReference Include="Catalyst.Models.English" Version="1.0.30952" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="System.Net.Http.Json" Version="9.0.9" />
    <PackageReference Include="System.Text.Json" Version="9.0.9" />
    <PackageReference Include="Microsoft.Msagl" Version="1.1.6" />
    <PackageReference Include="Microsoft.Msagl.Drawing" Version="1.1.6" />
    <PackageReference Include="Microsoft.Msagl.GraphViewerGdi" Version="1.1.7" />
  </ItemGroup>

  <!-- WinForms reference without implicit global usings (avoids conflicts with SixLabors / OpenTK) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

</Project>
