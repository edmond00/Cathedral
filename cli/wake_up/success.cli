# wake_up — success
#
# The wake_up verb carried through: forced past the dice, the outcome reports SUCCESS.
#
# Reached in 1/12 of the sampled location ids, with REAL schedules (no --npc-static).
# That flag pins everyone to their workplace all day, which is exactly what this verb cannot have:
# it needs somebody asleep in their own bed, and a pinned NPC never goes to bed.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --location-type test --location-id 0 --start-area "Test Room" --period night --observe-only "weaver"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy succeed
goal wake_up
advance 12 180
regions

click keyword 0
choose 0
choose 0
advance 12 180
regions

click action 0
choose 0
advance 12 180
click continue
advance 12 180
expect SUCCESS
# The OUTCOME, not just the banner. "SUCCESS" is the dice result — it is printed from
# result.Succeeded and says nothing about what the verb did, so a verb whose SuccessReports
# stopped producing anything would still pass every other assertion here. This is the chip
# the outcome block carries, and it is the only line that proves the verb had an effect.
expect Woken:

# What makes this a wake_up test rather than an any-verb test.
expect-verb wake_up
quit
