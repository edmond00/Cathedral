# introduction_granted — the outcome, not the verb.
#
# cli/verb/introduce_me/ proves the chip is printed. This proves the chip corresponds to something
# real: the world is inspected before and after, and it moved. The two overlap on purpose —
# same scenario, different question.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --location-type test --location-id 0 --npc-static --start-area "Test Yard" --period noon --observe-only "plowman"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

# --- before ---
inspect npcs
expect-state npcs "introduced=False"

strategy succeed
goal introduce_me
advance 12 180

click keyword 0
choose 0
choose 0
advance 12 180
regions

click action 0
choose 0
advance 12 180
click continue
advance 12 180


# --- the outcome really ran ---
expect-outcome introduction_granted

# --- after: the world moved ---
inspect npcs

# The introduction has two halves and only the first was ever asserted here. Being vouched for sets
# the standing (above); being TAKEN there is the other half, and it silently stopped working — the
# walk moved PoV.Where without moving the narration node, so the player stayed, observably, with the
# go-between. The test location pins the reeve to Test Hall and the plowman to Test Yard, so the area
# after the introduction is the whole assertion.
expect-state where Test Hall
quit
