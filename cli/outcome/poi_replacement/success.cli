# poi_replacement — the outcome, not the verb.
#
# cli/verb/break/ proves the chip is printed. This proves the chip corresponds to something
# real: the world is inspected before and after, and it moved. The two overlap on purpose —
# same scenario, different question.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --grant-item axe --location-type test --location-id 0 --start-area "Test Hall" --period dawn --observe-only "Test Crate"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

# --- before ---
inspect pois
expect-state pois "Test Crate"

strategy succeed
goal break
advance 12 180

click keyword 0
choose 0
choose 0
advance 12 180

click action 0
choose 1
regions
choose 0
advance 12 180

# Combining does not execute: it rewrites the action to include the tool and offers THAT as a new
# button. Executing the reformulated one is what puts CombinedItem on the action.
regions
click action 1
choose 0
advance 12 180
click continue
advance 12 180


# --- the outcome really ran ---
expect-outcome poi_replacement

# --- after: the world moved ---
inspect pois
expect-no-state pois "Test Crate"
expect-state pois "Test Broken Crate"
quit
