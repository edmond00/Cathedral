# wound_infliction — the outcome, not the verb.
#
# cli/verb/climb_up/ proves the chip is printed. This proves it corresponds to something real.
# The verb script runs in full and the outcome assertions go on the end.
#
# --penalty-only wound pins the draw. A penalty is DRAWN from FailurePenalties, and climb_up's table
# also wastes the hour; this script once ran at seed 7 instead of 42 because that seed happened to
# wound, which held only until the table changed.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --location-type test --location-id 0 --start-area "Test Rock" --period dawn --observe-only "Test Cliff" --penalty-only wound

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

# --- before ---
inspect wounds
expect-no-state wounds wound

strategy fail-dice
goal climb_up
advance 12 180

click keyword 0
choose 0
choose 0
advance 12 180
regions

click action 0
choose 0
advance 12 180
click continue
advance 12 180

expect FAILURE

# What makes this a climb_up test rather than an any-verb test: SUCCESS/FAILURE is the outcome banner
# of every verb alike, so only this can tell them apart.
expect-verb climb_up
# The failure assertion that means something: the verb's own consequence did NOT happen.
# Asserting the penalty instead would be flaky — FailurePenalties draws one entry of several,
# and only --penalty-only pins which (see cli/outcome/).
expect-no-outcome area_move

# --- the outcome really ran ---
expect-outcome wound_infliction

# --- after: the world moved ---
inspect wounds
quit
