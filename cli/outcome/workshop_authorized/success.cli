# workshop_authorized — the leave is real, and it is kept
#
# After the master gives the use of the smithy, the scene records it (inspect workshops), and the
# blacksmith's will plans straight to the anvil: USE on it is offered now — the thing the leave is for.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --grant-mm blacksmithing --grant-item hammer --location-type test --location-id 0 --start-area "Test Forge" --period dawn

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy succeed
goal ask_to_use_workshop
advance 12 180
click observe "blacksmith"
choose childhood_memory
advance 12 180
click think "blacksmith"
choose ripelore
advance 12 180
click act 0
choose 0
advance 12 180
click continue
advance 12 180
expect-outcome workshop_authorized
wait mode LocationInteraction 60
expect-state workshops authorized=yes

# The leave opens the anvil: the blacksmith's will, which had to plan through the smith before
# (cli/system/crafting_will_asks_leave.cli), now goes straight to the anvil in one step.
expect-state will will blacksmithing steps=1
expect-state will set to work at the test anvil
expect-state will aim=1/5
quit
