# corpse_item_acquisition — the outcome, not the verb.
#
# cli/verb/cut/ proves the chip is printed. This proves the chip corresponds to something
# real: the world is inspected before and after, and it moved. The verb script runs in full
# here — the two overlap on purpose, same scenario, different question.
#
# Slay and cut are Required verbs: the knife must be COMBINED with the action, not merely
# carried. It is the reference tool of both, so neither combination reaches the item critic
# (which picks at random under --playground).
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --grant-item knife --location-type test --location-id 0 --npc-static --start-area "Test Yard" --period noon --observe-only "chicken"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

# --- before ---
inspect items

# ── Make the corpse ──────────────────────────────────────────────────────────
strategy succeed
goal slay
advance 12 180
regions

click keyword 0
choose 0
choose 0
advance 12 180
click action 0
choose 1
regions
choose 0
advance 12 180
regions
click action 1
choose 0
advance 12 180
click continue
advance 12 180
expect SUCCESS
expect Slain:
expect-verb slay

# ── Now cut it ───────────────────────────────────────────────────────────────
# The corpse opens the phase on its own, so the keyword is whatever it left behind.
click button
advance 12 180
regions

goal cut
click keyword 0
choose 0
choose 0
advance 12 180
regions

click action 0
choose 1
regions
choose 0
advance 12 180
regions
click action 1
choose 0
advance 12 180
click continue
advance 12 180
expect SUCCESS

# What makes this a cut test rather than an any-verb test.
# The OUTCOME, not just the banner. "SUCCESS" is the dice result — it is printed from
# result.Succeeded and says nothing about what the verb did, so a verb whose SuccessReports
# stopped producing anything would still pass every other assertion here. This is the chip
# the outcome block carries, and it is the only line that proves the verb had an effect.
expect Item received:
expect-verb cut
# The outcome TYPE, asserted by its stable id rather than by chip wording. `expect <chip>`
# proves what the player was told; this proves what actually ran. See --outcome-audit.
expect-outcome corpse_item_acquisition

# --- the outcome really ran ---
expect-outcome corpse_item_acquisition

# --- after: the world moved ---
inspect items
quit
