# led_to_premises — the outcome, not the verb.
#
# cli/verb/ask_to_be_led/ proves the conversation opens. This proves where winning it leads: the
# poultry keeper, met in the Courtyard in the afternoon (the farm's arrival hour, which puts her there to greet the player), keeps the Storage Shed next at evening — so the
# player is walked to the Storage Shed and the time passes to evening, the keeper in focus.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --npc-affinity CloseFriend --location-type farm --location-id 1 --start-area "Courtyard" --period afternoon --observe-only "poultry_keeper"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

# --- before ---
inspect where
expect-state where Courtyard
expect-state where period=Afternoon

strategy succeed
goal ask_to_be_led
advance 12 180

click keyword 0
choose 0
choose 0
advance 12 180

click action 0
choose 0
advance 12 180
click continue
advance 12 180

# --- after ---
expect-outcome led_to_premises
inspect where
expect-state where Storage Shed
expect-state where period=Evening
quit
