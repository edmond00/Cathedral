# propose_to_join — success
#
# The propose_to_join verb carried through: forced past the dice, the outcome reports SUCCESS.
#
# Reached in 1/12 of the sampled location ids.
#
# --npc-affinity is what makes this writable: propose_to_join is gated on already knowing the person, and
# earning that in-script means holding a whole conversation and winning its roll — which would make
# this a test of THAT conversation. --auto-dialogue then settles the conversation this verb opens,
# so the assertion is about the verb. The trees are covered by cli/_systems/dialogue_*.cli.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --npc-affinity CloseFriend --location-type test --location-id 0 --npc-static --start-area "Test Hall" --period noon --observe-only "brewer"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy succeed
goal propose_to_join
advance 12 180
regions

click keyword 0
choose 0
choose 0
advance 12 180
regions

click action 0
choose 0
advance 12 180
click continue
advance 12 180
expect SUCCESS
# The OUTCOME, not just the banner. "SUCCESS" is the dice result — it is printed from
# result.Succeeded and says nothing about what the verb did, so a verb whose SuccessReports
# stopped producing anything would still pass every other assertion here. This is the chip
# the outcome block carries, and it is the only line that proves the verb had an effect.
expect Conversation:

# What makes this a propose_to_join test rather than an any-verb test.
expect-verb propose_to_join
quit
