# A lore world picked off the sky is the lore's world: its name in the moon box, its forced terrain,
# and its history generated by its own profile, with its lore beats in it.
#
# Runs WITHOUT --seed for the reason world_selection.cli does: the flag skips the selection screen.
# Still reproducible, because the sky and the lore moon table are both constants (Belune is moon 23
# in every process; see LoreMoons).
#
# FLAGS: --playground --skip-childhood --debug --no-encounters --silent --no-save --location-type test --location-id 0 --npc-static --period noon

wait
click menu New
wait mode WorldSelection 20
click moon Belune
wait
expect Belune

click world confirm
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60

# Belune is forced to eroded hills whatever its seed would have picked.
expect-state world-variant id=eroded
expect-state world-history Belune
expect-state world-history status=Held
expect-state world-history profile=BeluneProfile

# Lore beats, read off the chronology: the prophet, Josu's submarine, Jelebanne's kingdom, the end of
# the regency and the Inquisition. Asserted by their dates and wording, which are the lore's own.
expect-state world-events -900 FC: The Descended.
expect-state world-events 806 FC: Josu Exculato
expect-state world-events 1321 FC: Belune is made a kingdom of the empire
expect-state world-events 2532 FC: The end of the regency.
expect-state world-events The Principian Inquisition comes to Belune.
expect-state world-realms regions=

quit
