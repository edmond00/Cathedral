# will_kill_then_cut — a will whose object exists only after a kill wants the kill too
#
# Butchery wants to cut a carcass, and a carcass is spawned by the kill: before anything has died the
# planner has nothing to reach (it sees no further than a kill), and the will had nothing to do. It
# declares slaying a beast as its second target, so the plan goes for the chicken first (aim=2/2) and,
# once the body is down, for the body (aim=1/2) — cutting is declared first, and nearest wins.
#
# The kill half is copied from cli/verb/cut/success.cli: the knife is the reference tool of both verbs,
# so neither combination reaches the item critic.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --grant-mm butchery --grant-item knife --location-type test --location-id 0 --npc-static --start-area "Test Yard" --period noon --observe-only "chicken"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

# ── No carcass yet: the will wants the kill ──────────────────────────────────
strategy succeed
goal slay
advance 12 180

expect-state will "will butchery steps=1"
expect-state will "slay"
expect-state will "aim=2/2"
expect-state will "kill a beast for its meat"

click keyword 0
choose 0
choose 0
advance 12 180
click action 0
choose 1
choose 0
advance 12 180
click action 1
choose 0
advance 12 180
click continue
advance 12 180
expect Slain:
expect-verb slay

# ── The carcass is down: the will wants the cut ──────────────────────────────
click button
advance 12 180

expect-state will "will butchery steps=1"
expect-state will "cut"
expect-state will "aim=1/2"
expect-state will "cut a carcass into joints"
quit
