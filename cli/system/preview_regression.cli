# Regression script for the LLM generation-preview box (see src/game/narrative/preview/).
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --location-type test --location-id 0 --npc-static --start-area "Test Field" --period noon --observe-only "Test Berry Bush"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60
wait
strategy succeed

# Observation preview: the text streams into ONE box (the opener names "attention"), one CONTINUE.
# The bush is pinned, with gathering from it as the goal: an act no means of the kit refuses.
goal gather
click observe "Test Berry Bush"
choose childhood_memory
wait 45
expect CONTINUE
expect attention
click continue
wait

# Observation committed: the box is gone, and the text is on the element's node, read again under
# the pointer.
expect-not CONTINUE
expect-state texts "attention"

click think "Test Berry Bush"
choose ripelore
wait 45

# Thinking preview: reasoning part first, gated by CONTINUE.
expect CONTINUE
click continue
wait

# Action preview: the action line always opens with "I will".
expect I will
click continue
wait

# Thinking committed: the act hangs under the thought.
expect-state texts "I want to"
expect-state trees act state=waiting

click act 0
choose 0
wait 60

# Dice overlay resolved — confirm it, which triggers outcome generation.
click continue
wait 60

# Outcome preview box: only the true outcome is generated, opening first-person with "I".
expect CONTINUE
# "managed to" is NeutralNarration.OutcomeSuccess's wording ("It is done! I managed to …").
# This used to expect "tried to", which is now only the childhood-reminescence framing, and then
# "succeeded to", the wording before it was made English.
expect managed to
click continue
wait 60

# Outcome committed: the result box is up, and the outcome is a node under its act.
expect SUCCESS
expect-state trees success
quit
