# --world-variant overrides the variant a seed names, and the save refuses to be continued into a
# world of a different kind.
#
# The flag exists because a variant is otherwise reached only by finding a moon that happens to be
# it, and there are ten of them over three hundred and eighty-three moons. This is how a playtest
# looks at The Riven Spine on purpose.
#
# Seed 42 names The Green Shroud on its own, so forcing riven-spine here proves the override really
# is an override rather than a coincidence — `seed-names` reports what the seed wanted and `forced`
# reports that it did not get it.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --world-variant riven-spine --no-encounters --silent

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 45

expect-state world-variant id=riven-spine
expect-state world-variant forced=yes
expect-state world-variant seed-names=green-shroud

# The thresholds are the forced variant's, not the seed's: The Riven Spine drops the treeline from
# the baseline's 0.300 so mountains start far lower, and stretches the relief scale into ranges.
expect-state world-variant mountain=0.100
expect-state world-variant relief=6.0

# A world this shape is still a world: land under the avatar, divided into regions, with every
# border readable. The region division is calibrated on the baseline, and a variant that broke it
# would break it here.
expect-no-state world-regions region=-1
expect-state world-regions conflicts=0
expect-state world-regions borders=distinct

# The variant is written into the save beside the seed, because the seed alone no longer names a
# world. Continuing without the flag is refused rather than dropping the avatar onto a vertex that
# is open ocean in the world the seed would have built.
save roundtrip
expect-state save variant=riven-spine

world
quit
