# slay — success
#
# The slay verb carried through: forced past the dice, the outcome block reports SUCCESS.
#
# Reached in 12/12 of the sampled location ids (see --verb-probe). --location-type and
# --location-id decide the whole scene, so this does not depend on world generation; --npc-static
# pins people to one room; --observe-only pins the phase to one object, which is why the keyword is
# clicked by index (which word the prose highlights is not something a test can know).
#
# Slay is a Required verb: a knife must be COMBINED with the action, not merely carried. Since the
# knife is slay's own reference tool the combination is accepted without a critic call at all
# (ToolCombinationRules.IsMadeFor), which is what makes this deterministic — under --playground the
# item critic picks its verdict at random, so a substitute would pass or fail by seed.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --grant-item knife --location-type test --location-id 0 --start-area "Test Hall" --period dawn --observe-only "brewer"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy succeed
goal slay
advance 12 180

click keyword 0
choose 0
choose 0
advance 12 180
regions

click action 0
choose 1
regions
choose 0
advance 12 180

# Combining does not execute: it rewrites the action to include the tool and offers THAT as a new
# button. Executing the reformulated one is what puts CombinedItem on the action.
regions
click action 1
choose 0
advance 12 180
click continue
advance 12 180

expect SUCCESS
# The OUTCOME, not just the banner. "SUCCESS" is the dice result — it is printed from
# result.Succeeded and says nothing about what the verb did, so a verb whose SuccessReports
# stopped producing anything would still pass every other assertion here. This is the chip
# the outcome block carries, and it is the only line that proves the verb had an effect.
expect Slain:

# What makes this a slay test rather than an any-verb test: SUCCESS/FAILURE is the outcome banner
# of every verb alike, so only this can tell them apart.
expect-verb slay
# The outcome TYPE, asserted by its stable id rather than by chip wording. `expect <chip>`
# proves what the player was told; this proves what actually ran. See --outcome-audit.
expect-outcome npc_slayn
quit
