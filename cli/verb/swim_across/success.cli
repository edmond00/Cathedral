# swim_across — success
#
# The swim_across verb carried through: forced past the dice, the outcome reports SUCCESS.
#
# Reached in 2/12 of the sampled location ids.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --location-type test --location-id 0 --start-area "Test Field" --period dawn --observe-only "Test Ford"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy succeed
goal swim_across
advance 12 180
regions

click keyword 0
choose 0
choose 0
advance 12 180
regions

click action 0
choose 0
advance 12 180
click continue
advance 12 180

expect SUCCESS
# The OUTCOME, not just the banner. "SUCCESS" is the dice result — it is printed from
# result.Succeeded and says nothing about what the verb did, so a verb whose SuccessReports
# stopped producing anything would still pass every other assertion here. This is the chip
# the outcome block carries, and it is the only line that proves the verb had an effect.
expect Moved to:

# What makes this a swim_across test rather than an any-verb test.
expect-verb swim_across
# The outcome TYPE, asserted by its stable id rather than by chip wording. `expect <chip>`
# proves what the player was told; this proves what actually ran. See --outcome-audit.
expect-outcome area_move
quit
