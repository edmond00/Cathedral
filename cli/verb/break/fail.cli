# break — fail
#
# The break verb attempted and missed: the checks pass, the dice do not, and the outcome block reports FAILURE.
#
# Reached in 3/12 of the sampled location ids (see --verb-probe). --location-type and
# --location-id decide the whole scene, so this does not depend on world generation; --npc-static
# pins people to one room; --observe-only pins the phase to one object, which is why the keyword is
# clicked by index (which word the prose highlights is not something a test can know).
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --grant-item axe --location-type test --location-id 0 --start-area "Test Hall" --period dawn --observe-only "Test Crate"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy fail-dice
goal break
advance 12 180

click keyword 0
choose 0
choose 0
advance 12 180

click action 0
choose 1
regions
choose 0
advance 12 180

# Combining does not execute: it rewrites the action to include the tool and offers THAT as a new
# button. Executing the reformulated one is what puts CombinedItem on the action.
regions
click action 1
choose 0
advance 12 180
click continue
advance 12 180

expect FAILURE

# What makes this a break test rather than an any-verb test: SUCCESS/FAILURE is the outcome banner
# of every verb alike, so only this can tell them apart.
expect-verb break
# The failure assertion that means something: the verb's own consequence did NOT happen.
# Asserting the wound instead would be flaky — FailurePenalties samples one slot in five,
# so most failures injure nobody.
expect-no-outcome poi_replacement
quit
