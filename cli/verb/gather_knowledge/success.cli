# gather_knowledge — success
#
# The gather_knowledge verb carried through: forced past the dice, the outcome block reports SUCCESS.
#
# Reached in 1/12 of the sampled location ids (see --verb-probe). --location-type and
# --location-id decide the whole scene, so this does not depend on world generation; --npc-static
# pins people to one room; --observe-only pins the phase to one object, which is why the keyword is
# clicked by index (which word the prose highlights is not something a test can know).
#
#
# --npc-affinity: gather_knowledge is gated on already having been introduced (see
# SocialDialogueVerb.RequiresAcquaintance) — asking a total stranger what they know about
# the district was offered ahead of learning their name. Earning that in-script means
# holding the meet_stranger conversation first, which would make this a test of that tree.
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --npc-affinity DistantAcquaintance --location-type test --location-id 0 --start-area "Test Hall" --period dawn --observe-only "brewer"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy succeed
goal gather_knowledge
advance 12 180

click keyword 0
choose 0
choose 0
advance 12 180
regions

click action 0
choose 0
advance 12 180
click continue
advance 12 180

expect SUCCESS
# The OUTCOME, not just the banner. "SUCCESS" is the dice result — it is printed from
# result.Succeeded and says nothing about what the verb did, so a verb whose SuccessReports
# stopped producing anything would still pass every other assertion here. This is the chip
# the outcome block carries, and it is the only line that proves the verb had an effect.
expect Conversation:

# What makes this a gather_knowledge test rather than an any-verb test: SUCCESS/FAILURE is the outcome banner
# of every verb alike, so only this can tell them apart.
expect-verb gather_knowledge
# The outcome TYPE, asserted by its stable id rather than by chip wording. `expect <chip>`
# proves what the player was told; this proves what actually ran. See --outcome-audit.
expect-outcome dialogue_trigger
quit
