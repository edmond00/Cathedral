# mine — success
#
# The mine verb carried through: forced past the dice, the outcome block reports SUCCESS.
#
# Reached in 3/12 of the sampled location ids (see --verb-probe). --location-type and
# --location-id decide the whole scene, so this does not depend on world generation; --npc-static
# pins people to one room; --observe-only pins an observation to one object, which the script
# names again when it clicks its symbol.
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --grant-item pick --location-type test --location-id 0 --start-area "Test Rock" --period dawn --observe-only "Test Ore Seam"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy succeed
goal mine
advance 12 180

click observe "Test Ore Seam"
choose childhood_memory
advance 12 180
click think "Test Ore Seam"
choose ripelore
advance 12 180

click act 0
choose 1
regions
choose 0
advance 12 180

# Combining does not execute: it rewrites the action to include the tool and offers THAT as a new
# act. Executing the reformulated one is what puts CombinedItem on the action.
regions
click act 1
choose 0
advance 12 180
click continue
advance 12 180

expect SUCCESS
# The OUTCOME, not just the banner. "SUCCESS" is the dice result — it is printed from
# result.Succeeded and says nothing about what the verb did, so a verb whose SuccessReports
# stopped producing anything would still pass every other assertion here. This is the chip
# the outcome block carries, and it is the only line that proves the verb had an effect.
expect Item received:

# What makes this a mine test rather than an any-verb test: SUCCESS/FAILURE is the outcome banner
# of every verb alike, so only this can tell them apart.
expect-verb mine
# The outcome TYPE, asserted by its stable id rather than by chip wording. `expect <chip>`
# proves what the player was told; this proves what actually ran. See --outcome-audit.
expect-outcome item_acquisition
quit
