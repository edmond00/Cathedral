# cut_wood — success
#
# The cut_wood verb carried through: forced past the dice, the outcome block reports SUCCESS.
#
# Reached in 11/12 of the sampled location ids (see --verb-probe). --location-type and
# --location-id decide the whole scene, so this does not depend on world generation; --npc-static
# pins people to one room; --observe-only pins the phase to one object, which is why the keyword is
# clicked by index (which word the prose highlights is not something a test can know).
#
# FLAGS: --playground --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --grant-item axe,sack --location-type test --location-id 0 --start-area "Test Wood" --period dawn --observe-only "Test Timber Tree"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy succeed
goal cut_wood
advance 12 180

click keyword 0
choose 0
choose 0
advance 12 180

click action 0
choose 1
regions
choose 0
advance 12 180

# Combining does not execute: it rewrites the action to include the tool and offers THAT as a new
# button. Executing the reformulated one is what puts CombinedItem on the action.
regions
click action 1
choose 0

# Settle, confirm the dice, settle again — twice, because which of the two overlays (the dice
# confirm and the outcome preview) is up first is not fixed: `mine` reaches the dice button on the
# first press and this verb reaches the preview, and a script that assumes one order stalls with the
# outcome still unresolved. `click continue` on an absent button is a no-op, not an assertion.
advance 12 180
click continue
advance 12 180
click continue
advance 12 180

expect SUCCESS
# The OUTCOME, not just the banner. "SUCCESS" is the dice result — it is printed from
# result.Succeeded and says nothing about what the verb did, so a verb whose SuccessReports
# stopped producing anything would still pass every other assertion here. This is the chip
# the outcome block carries, and it is the only line that proves the verb had an effect.
expect Item received:

# What makes this a cut_wood test rather than an any-verb test: SUCCESS/FAILURE is the outcome banner
# of every verb alike, so only this can tell them apart.
expect-verb cut_wood
# The outcome TYPE, asserted by its stable id rather than by chip wording. `expect <chip>`
# proves what the player was told; this proves what actually ran. See --outcome-audit.
expect-outcome item_acquisition
quit
