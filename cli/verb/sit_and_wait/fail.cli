# sit_and_wait — fail
#
# The sit_and_wait verb attempted and missed: the checks pass, the dice do not, and the outcome block reports FAILURE.
#
# Reached in 4/12 of the sampled location ids (see --verb-probe). --location-type and
# --location-id decide the whole scene, so this does not depend on world generation; --npc-static
# pins people to one room; --observe-only pins an observation to one object, which the script
# names again when it clicks its symbol.
#
# The verb's base difficulty is 0, which rolls nothing and cannot fail; --willingness reluctant
# raises it to 1 (Verb.ActionDifficulty), so there is a roll for fail-dice to miss.
#
# FLAGS: --playground --willingness reluctant --skip-childhood --debug --seed 42 --no-encounters --auto-dialogue --location-type test --location-id 0 --start-area "Test Yard" --period dawn --observe-only "Test Bench"

wait
click menu New
wait mode ProtagonistCreation 20
click continue
wait mode WorldView 60
travel here
wait mode LocationInteraction 60

strategy fail-dice
goal sit_and_wait
advance 12 180

click observe "Test Bench"
choose childhood_memory
advance 12 180
click think "Test Bench"
choose ripelore
advance 12 180
regions

click act 0
choose 0
advance 12 180
click continue
advance 12 180

expect FAILURE

# What makes this a sit_and_wait test rather than an any-verb test: SUCCESS/FAILURE is the outcome banner
# of every verb alike, so only this can tell them apart.
expect-verb sit_and_wait
# The failure assertion that means something: the verb's own consequence did NOT happen.
# Asserting the penalty instead would be flaky — FailurePenalties draws one entry of several,
# and only --penalty-only pins which (see cli/outcome/).
expect-no-outcome time_shift
quit
