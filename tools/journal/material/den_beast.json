    {
      "Seq": 11,
      "Kind": 0,
      "Day": 0,
      "Place": "Cold steppe",
      "Area": "Test Den",
      "LocationId": 20369,
      "Actor": "Gaios the Fair",
      "ByCompanion": false,
      "Source": "I turn my head to the grey wolf, pacing at the tree-line. His eyes, fixed and low, whisper secrets of the night. He means no harm, but I remain vigilant, a shadow in the steppe.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 0,
      "Key": ""
    },
    {
      "Seq": 12,
      "Kind": 0,
      "Day": 0,
      "Place": "Cold steppe",
      "Area": "Test Den",
      "LocationId": 20369,
      "Actor": "Gaios the Fair",
      "ByCompanion": false,
      "Source": "I observe the grey wolf\u0027s pacing at the tree-line, its head low and eyes fixed, but I am of higher lineage and rank than this common sight. My intent is to turn my attention to a more worthy cause, one that does not require the faintest hint of a courtesy.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 1,
      "Key": ""
    },
    {
      "Seq": 13,
      "Kind": 0,
      "Day": 0,
      "Place": "Cold steppe",
      "Area": "Test Den",
      "LocationId": 20369,
      "Actor": "Gaios the Fair",
      "ByCompanion": false,
      "Source": "I note the grey wolf\u0027s pacing at the tree-line, its head low and eyes fixed, but I discern no rank in this place, no lineage to honour here. I shall turn my attention to the stars, the ancient tales and the winds that whisper secrets of old.",
      "Written": "",
      "State": 1,
      "Group": 2,
