    {
      "Seq": 25,
      "Kind": 0,
      "Day": 6,
      "Place": "Coast",
      "Area": "Square",
      "LocationId": 15902,
      "Actor": "Kenryc Greygate",
      "ByCompanion": false,
      "Source": "I mark the thorn hedge, a square-craft row, thick with thorns pleached to turn the quarry, drawing my attention to the thorny barrier. I sharpen my focus on the run. A square-back lane leads on, a green edge guides, and a well yard beckons the quarry. I follow the square-back lane, a well-trodden path from square to back lane, through the well yard. My attention sharpens on the run, marking the quarry\u0027s path.",
