    {
      "Seq": 17,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Square",
      "LocationId": 4010,
      "Actor": "Kenryc Greygate",
      "ByCompanion": false,
      "Source": "I look upon an ivy-grown house, recalling my childhood hideaways from looters. It is a squat timber-framed two-storey house, with ivy climbing over its thatched roof, much like the one we hid behind as mice scurried. I let my focus go, as if the coast\u0027s quiet reminded me of the farm\u0027s calm, where looters\u0027 echoes faded into the distant hills.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 0,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
