    {
      "Seq": 10,
      "Kind": 3,
      "Day": 0,
      "Place": "Coast",
      "Area": "",
      "LocationId": 4010,
      "Actor": "Kenryc Greygate",
      "ByCompanion": false,
      "Source": "First came to the coast",
      "Written": "",
      "State": 0,
