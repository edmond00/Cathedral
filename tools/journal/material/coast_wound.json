    {
      "Seq": 11,
      "Kind": 0,
      "Day": 0,
      "Place": "Plain",
      "Area": "Tide Pool Zone",
      "LocationId": 26448,
      "Actor": "Aentonyuz the Wild",
      "ByCompanion": false,
      "Source": "I find myself among the tide pools, a shelf of rock pitted with pools the tide leaves full, each a small world. Around me are marks of alleys, exits marked, a sand flat, a thicket of bramble, a crab, a pool, and a rocky shore. I notice a sound, the alley\u0027s racing between the shore and the rock, waves running through it and cold rising from below.",
      "Written": "",
      "State": 0,
      "Group": 2,
      "Block": 0,
      "Key": ""
    },
    {
      "Seq": 12,
      "Kind": 0,
      "Day": 0,
      "Place": "Plain",
      "Area": "Tide Pool Zone",
      "LocationId": 26448,
      "Actor": "Aentonyuz the Wild",
      "ByCompanion": false,
      "Source": "I mark the sun-warmed slab of rock above the tideline. Dry and warm on its landward side, it beckons. I will rely on my skills to survive here, choosing each step with care.",
      "Written": "",
      "State": 0,
      "Group": 2,
      "Block": 1,
      "Key": ""
    },
    {
      "Seq": 13,
      "Kind": 0,
      "Day": 0,
      "Place": "Plain",
      "Area": "Tide Pool Zone",
      "LocationId": 26448,
      "Actor": "Aentonyuz the Wild",
      "ByCompanion": false,
      "Source": "I failed to heed the flat rock, lost the thread of thoughts, starved before night.",
      "Written": "",
      "State": 0,
      "Group": 2,
      "Block": 3,
      "Key": ""
    },
    {
      "Seq": 14,
      "Kind": 2,
      "Day": 0,
      "Place": "Plain",
      "Area": "Tide Pool Zone",
      "LocationId": 26448,
      "Actor": "Aentonyuz the Wild",
      "ByCompanion": false,
      "Source": "Focus lost: -1 noetic point",
      "Written": "",
      "State": 0,
