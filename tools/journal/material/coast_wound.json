    {
      "Seq": 17,
      "Kind": 0,
      "Day": 5,
      "Place": "Plain",
      "Area": "Tide Pool Zone",
      "LocationId": 26446,
      "Actor": "Aentonyuz the Wild",
      "ByCompanion": false,
      "Source": "I find myself among the tide pools, in the morning, just as I did when the looters raided our home. Each pool is a small world, a parallel to the chaos I once faced, where survival was as simple as finding sustenance in the dirt. I watch the tide pool, a memory of a similar place where I once pretended to be dead among corpses, the anemones at the bottom of this cupped rock pool now drawing my attention.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 0,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
      "Seq": 18,
      "Kind": 0,
      "Day": 5,
      "Place": "Plain",
      "Area": "Tide Pool Zone",
      "LocationId": 26446,
      "Actor": "Aentonyuz the Wild",
      "ByCompanion": false,
      "Source": "I mark the rock by the salt-bright pool, wary of its depth. I grip the knots, ready to swing between the trees by the exit.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 1,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
      "Seq": 19,
      "Kind": 0,
      "Day": 5,
      "Place": "Plain",
      "Area": "Tide Pool Zone",
      "LocationId": 26446,
      "Actor": "Aentonyuz the Wild",
      "ByCompanion": false,
      "Source": "I could not tighten my grip on the rock, and thus lost the thread of my thoughts, a line slackened under the strain of my own failure.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 3,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "grab a rock",
      "Succeeded": false
    },
    {
      "Seq": 20,
      "Kind": 0,
      "Day": 5,
      "Place": "Plain",
      "Area": "Tide Pool Zone",
      "LocationId": 26446,
      "Actor": "Aentonyuz the Wild",
      "ByCompanion": false,
      "Source": "I was drawn to a tide pool once, like this one, where anemones swayed in the rock\u0027s grip. It reminds me of how I\u0027d search for food by the sea, pretending to be invisible until the day\u0027s danger passed. I recall pretending to be dead among corpses, and now, a scuttling crab draws my attention, its claws still snapping. I let my focus go, where once I let my wits wander on the streets, a child without a penny to spare.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 0,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    }
