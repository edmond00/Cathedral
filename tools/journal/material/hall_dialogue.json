    {
      "Seq": 61,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Test Hall",
      "LocationId": 36181,
      "Actor": "Ernaeulht the White",
      "ByCompanion": false,
      "Source": "I found him at the edge of the courtyard, his eyes still wary but his body relaxed. With a gentle smile, I invited him closer, and as he sat, I noticed the way his hands trembled. It only stretched, but I knew there was always room. It felt right to sit with him, to listen to what he knew of his work and of this place. Thanks to this, I began our conversation, learned his stories, and felt a warmth grow within me.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 3,
      "Key": ""
    },
