    {
      "Seq": 11,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Test Hall",
      "LocationId": 36181,
      "Actor": "Ernaeulht the White",
      "ByCompanion": false,
      "Source": "I find myself in the test hall, at noon, and it feels like a parallel to the storm I pushed through. Around me is the brewer of the coast, a man like the one who helped me navigate those tempests. I look at the brewer of the coast, a man, and recall the stormy day when I pushed through until my legs gave out. His judgement and scrutiny mirror the moment when I, too, had to navigate a turbulent journey without a clear path.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 0,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
      "Seq": 12,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Test Hall",
      "LocationId": 36181,
      "Actor": "Ernaeulht the White",
      "ByCompanion": false,
      "Source": "I sense a fellow tapping a cask, his brow furrowed as he sniffs the froth. No one else here with nothing in front of them. Already asks me something before I finish arriving. Watches carefully what I wear and carry. Desire to introduce myself, relying on force to strike up a conversation.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 1,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
