    {
      "Seq": 11,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Test Hall",
      "LocationId": 36181,
      "Actor": "Ernaeulht the White",
      "ByCompanion": false,
      "Source": "I find myself in the test hall, at noon, and it feels like a parallel to the storm I pushed through until my legs gave out. The brewer of the coast stands as a man, reminiscent of the strict tutor who guided my lessons. I catch the eye of the brewer by the coast, a man whose presence feels as familiar as the scent of smoke from the hearth. His scrutiny mirrors my own childhood vigilance, as if he were a tutor assessing the lessons I carry.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 0,
      "Key": ""
    },
    {
      "Seq": 12,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Test Hall",
      "LocationId": 36181,
      "Actor": "Ernaeulht the White",
      "ByCompanion": false,
      "Source": "I sense a man taps a cask, his brow furrowed as he sniffs the froth. Alone in the room, he already questions before I've begun to speak. I note his attire, his carry, and wish to engage. How do I start this conversation? With overwhelming force, perhaps?",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 1,
      "Key": ""
    },
    {
      "Seq": 13,
      "Kind": 3,
      "Day": 0,
      "Place": "Coast",
      "Area": "Test Hall",
      "LocationId": 36181,
      "Actor": "Ernaeulht the White",
      "ByCompanion": false,
      "Source": "Learned social interaction",
