    },
    {
      "Seq": 14,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Test Hall",
      "LocationId": 36181,
      "Actor": "Ernaeulht the White",
      "ByCompanion": false,
      "Source": "I smashed through the silence, my voice a thunderous roar that made his ears ring. With brute force, I forced the conversation, crushing Aeemilyus's hesitation like a spider beneath a boot. Success!",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 3,
      "Key": ""
    },
