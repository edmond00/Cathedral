    },
    {
      "Seq": 60,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Test Hall",
      "LocationId": 36181,
      "Actor": "Ernaeulht the White",
      "ByCompanion": false,
      "Source": "I question what he knows of his work and of this place, brow furrowed in judgement. What draws me is the welcoming and care of guests and travellers, already asking of what I am wearing and carrying, before I have finished arriving.",
      "Written": "",
      "State": 1,
