    {
      "Seq": 12,
      "Kind": 0,
      "Day": 0,
      "Place": "Plain",
      "Area": "Square",
      "LocationId": 28437,
      "Actor": "Nyccolhoth Lhavyniwyn",
      "ByCompanion": false,
      "Source": "I find myself at noon in the village square, where my days at the stable once echoed. The wayside cross and the mounting block remind me of the times I pushed through a violent storm until my legs gave out. I was once at the stable, and I remember the ways leading on, just as now. A green edge, a waterside, a village orchard, and a threshing floor - all familiar, yet distant memories of my childhood.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 0,
      "Key": ""
    },
    {
      "Seq": 13,
      "Kind": 0,
      "Day": 0,
      "Place": "Plain",
      "Area": "Square",
      "LocationId": 28437,
      "Actor": "Nyccolhoth Lhavyniwyn",
      "ByCompanion": false,
      "Source": "I spy an ancient, weathered stone cross, its carvings worn smooth like the hands of a wise old man. But there's naught here to mend, so I'll jest and turn my gaze to the sky.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 1,
      "Key": ""
    },
    {
      "Seq": 14,
      "Kind": 0,
      "Day": 0,
      "Place": "Plain",
