    {
      "Seq": 17,
      "Kind": 0,
      "Day": 5,
      "Place": "Plain",
      "Area": "Square",
      "LocationId": 1824,
      "Actor": "Nyccolhoth Lhavyniwyn",
      "ByCompanion": false,
      "Source": "I find myself at noon in the village square, where my days spent at the stable now echo, each footstep crossing as I once pushed through a storm, my legs aching yet determined. I remember the stable, and these steps felt both familiar and strange, like a return to a childhood where I too would climb them to mount a horse.",
      "Written": "",
      "State": 1,
      "Group": 4,
      "Block": 0,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
      "Seq": 18,
      "Kind": 0,
      "Day": 5,
      "Place": "Plain",
      "Area": "Square",
      "LocationId": 1824,
      "Actor": "Nyccolhoth Lhavyniwyn",
      "ByCompanion": false,
      "Source": "I spy no more than three steps of stone to mount a steed or sit when off duty. I seek the mounting block and let the days slip by. My care will come from the guests and travelers, for here in this plain, jests are born to lighten the load.",
      "Written": "",
      "State": 1,
      "Group": 4,
      "Block": 1,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
