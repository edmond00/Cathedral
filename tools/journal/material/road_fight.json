    {
      "Seq": 20,
      "Kind": 0,
      "Day": 6,
      "Place": "Plain",
      "Area": "Square",
      "LocationId": 1824,
      "Actor": "Nyccolhoth Lhavyniwyn",
      "ByCompanion": false,
      "Source": "I sit on the mounting block, feeling the earth beneath my feet. As dawn approaches, I watch the sky, my thoughts quiet and welcoming. Thank you for this moment, and for the time to pass in peace.",
