    {
      "Seq": 15,
      "Kind": 0,
      "Day": 0,
      "Place": "Plain",
      "Area": "Hedgerow",
      "LocationId": 8068,
      "Actor": "Eghbert Moorshield",
      "ByCompanion": false,
      "Source": "I watch the blades of grass sway in the wind, a scene much like when I played among the fields, the sky above vast and unbroken, as it was when I used to imagine myself among the corpses looters left. I glance at a gate bar, recalling how my friends and I would play near the sagging five-bar gate with its top rail worn smooth by our laughter. I reach out to a berry bush, a familiar thorny shrub from my childhood, heavy with drupelets like the one I once gathered to survive the looters.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 0,
      "Key": ""
    },
    {
