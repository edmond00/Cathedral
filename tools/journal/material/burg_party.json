    {
      "Seq": 19,
      "Kind": 0,
      "Day": 5,
      "Place": "Village",
      "Area": "Square",
      "LocationId": 6800,
      "Actor": "Ghiulhiano Windhill",
      "ByCompanion": false,
      "Source": "I listened to the goose\u0027s call, my fingers quick as shadows, and it did me proud. A small success that taught me much of birdsong\u0027s soft, hidden language.",
      "Written": "",
      "State": 1,
      "Group": 3,
