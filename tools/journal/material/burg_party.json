    {
      "Seq": 11,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Square",
      "LocationId": 26965,
      "Actor": "Ghiulhiano Windhill",
      "ByCompanion": false,
      "Source": "I find myself in the village square, afternoon\u0027s heat warming my skin, and a well, goose, mounting block, stocks, and cross stand as silent sentinels from my childhood at the stable. I find myself at the edge of the stable, where the ways lead on from here. Like then, the church walk, the cattle pen, and the threshing floor are all part of this expansive space. I let my focus go, where the stable animals once tormented me, and I let the storm rage on without turning back.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 0,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
      "Seq": 12,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Square",
      "LocationId": 26965,
      "Actor": "Ghiulhiano Windhill",
      "ByCompanion": false,
      "Source": "I spy a well at the heart of the square, its wooden bucket dangling, but the scene\u0027s dull as a dead fish. Time to find some levity, perhaps a jest at the expense of my own boredom.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 1,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
      "Seq": 13,
      "Kind": 0,
      "Day": 0,
      "Place": "Coast",
      "Area": "Square",
      "LocationId": 26965,
      "Actor": "Ghiulhiano Windhill",
      "ByCompanion": false,
      "Source": "I spy a well at the heart of the square, its wooden bucket dangling on a rope, but it\u0027s clear no treasure lies here. Might as well cast my gaze upon a jesting sea creature instead.",
      "Written": "",
      "State": 1,
      "Group": 2,
      "Block": 1,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
