    {
      "Seq": 16,
      "Kind": 0,
      "Day": 5,
      "Place": "Village",
      "Area": "Square",
      "LocationId": 6800,
      "Actor": "Ghiulhiano Windhill",
      "ByCompanion": false,
      "Source": "I walk through the heart of the village, the afternoon sun warming my back. A goose steps with purpose, its head held high. The forge\u0027s scent rises, a familiar call to iron and fire. My eyes scan the paths, each one a story of the day. A wayside cross stands firm, a silent witness to the village\u0027s heartbeat. The market stall beckons, a balm for weary travelers. I scent the earthy air, the horse\u0027s breath quickens as it steps onto the squat stone steps, its posture tense, warning me of a hidden danger in the forest.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 0,
      "Key": "",
      "Phrase": "",
      "Lesson": false,
      "Attempt": "",
      "Succeeded": false
    },
    {
      "Seq": 17,
      "Kind": 0,
      "Day": 5,
      "Place": "Village",
      "Area": "Square",
      "LocationId": 6800,
      "Actor": "Ghiulhiano Windhill",
      "ByCompanion": false,
      "Source": "I spy a white goose, hissing with neck stretched. Curious, I want to hear its squawk. Perhaps I\u0027ll steal an apple instead, for pocket picking\u0027s a lighter jest.",
      "Written": "",
      "State": 1,
      "Group": 3,
