    {
      "Seq": 21,
      "Kind": 0,
      "Day": 5,
      "Place": "Village",
      "Area": "Square",
      "LocationId": 6800,
      "Actor": "Ghiulhiano Windhill",
      "ByCompanion": false,
      "Source": "I wander the village square, afternoon's warmth settling. Here, a dirt path weaves through, scent of earth and fresh hay. My gaze catches the market stall, the goose's wary eye. The stocks stand silent, the mounting block ready. Every step echoes, a village heartbeat. I catch the scent of caution, the posture of a beast wary. A church walk, a cattle pen, a threshing floor - each way leads on, each hinting at unseen danger.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 0,
      "Key": ""
    },
    {
      "Seq": 22,
      "Kind": 0,
      "Day": 5,
      "Place": "Village",
      "Area": "Square",
      "LocationId": 6800,
      "Actor": "Ghiulhiano Windhill",
      "ByCompanion": false,
      "Source": "I spy a gleaming market stall, its goods arrayed for sale. I seek the laughter in this market, relying on the warmth of strangers and travelers to lift my spirits.",
      "Written": "",
      "State": 1,
      "Group": 3,
      "Block": 1,
      "Key": ""
    },
