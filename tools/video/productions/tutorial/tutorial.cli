click element organ:right_leg
hold 2
point element organ:left_foot
hold 2
point element organ:right_foot
hold 3
cursor rest
hold 3
clip end organs_fighting

click continue
wait mode ChildhoodReminescence 900

# ── Childhood: five memories, remembered for real ───────────────────────────────────────────────────
# Each reminescence observes only the fragment --childhood-path names for it, and its keyword is
# clicked by that fragment (`@name`), not by the word the model happened to write.
#   1. sobs                                   → the port city
#   2. the sound of waves and smell of sweat  → work on the docks
#   3. something sharp                        → a short sword (the WEAPON)
#   4. dream of a golden arch                 → the traveller's backpack, bread and cheese inside (the CONSUMABLE)
#   5. shelter                                → no item (exploration, endurance); the phase ends
# No fragment on this path grants footwear (the stable, farm and castle fragments do).
mark childhood
clip childhood_1
advance 12 900
cursor rest
hold 4
click keyword @sobs
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 4
click button
clip end childhood_1

clip childhood_2
advance 12 900
cursor rest
hold 4
click keyword @waves
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 4
click button
clip end childhood_2

clip childhood_3
advance 12 900
cursor rest
hold 4
click keyword @sharp
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 4
click button
clip end childhood_3

clip childhood_4
advance 12 900
cursor rest
hold 4
click keyword @golden
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 4
click button
clip end childhood_4

clip childhood_5
advance 12 900
cursor rest
hold 4
click keyword @shelter
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 4
click button
clip end childhood_5

