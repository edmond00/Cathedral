# The opening of the tutorial: tutorial.cli from the main menu to the run's start (creation, the five
# childhood memories, getting up), recorded on its own so it can be re-shot without the rest of the
# take. It ends once the world map has been reached, where the run's first autosave lands as a
# checkpoint (saves/ in the take's folder).
#
# Player commands only (this runs under --record), with the real model writing every passage. The
# launch flags, what each section relies on and every known fragility are in NOTES.md beside this
# file. In short: the world is Fenumoth (moon 5, a sylvan world), the childhood is pinned to the port
# city, the dock work, the sword and the dream of the golden arch (--childhood-path), the two journeys
# each meet one wolf (--force-encounter), the farmer and the cobbler are found where the script expects
# them (--start-area, --npc-static, --observe-only), the farmer offers only the farmhand's post
# (--job-only) and the two wills (diligence, provisioning) make the asking and the buying a single
# thought each. Every roll a script cannot foresee is settled with the humors the player really holds
# (--humors all=voluptas), spent with `click humor <queue> needed` / `click die needed`, which press
# only while the roll is still failing.
#
# Model waits are long on purpose (a passage takes a minute or more on a CPU); the cut fast-forwards
# them. `clip` names follow the brief's outline; `hold`s are where the narration will speak.
#
# FLAGS: --childhood-path "sobs,waves,sharp,golden arch,shelter" --force-encounter wolf,wolf --no-encounters
#        --npc-static --start-area "Longhouse Hall,Cobbler's Shop" --observe-only "farmer,cobbler"
#        --npc-affinity DistantAcquaintance --grant-mm diligence,provisioning,swordsmanship:2
#        --job-only farmhand --humors all=voluptas

# The narrowing flags name the farm's and the city's rooms and people; the childhood, the get-up and
# the world map have none of them, which is expected.
allow-flag-miss --start-area
allow-flag-miss --observe-only

# ── New run ──────────────────────────────────────────────────────────────────────────────────────────
# The model loads before the menu is offered.
wait mode MainMenu 900
mark new_run
clip new_run
cursor rest
hold 6
click menu New
wait mode WorldSelection 900
clip end new_run

# ── Select a world ───────────────────────────────────────────────────────────────────────────────────
# The sky is drawn from a constant, so Fenumoth is the same moon, in the same place, on every machine
# — and it is in view without turning the sky (under --record a moon must be on screen to be clicked).
# Hold on the sky (world generation, history, the lore), point at two other moons, pick Fenumoth and
# read its box.
mark world_selection
clip world_selection
cursor rest
hold 10
point moon Isholmir
hold 6
point moon Halarriel
hold 6
click moon Fenumoth
wait 900
cursor rest
hold 12
click world confirm
wait mode ProtagonistCreation 900
clip end world_selection

# ── Protagonist creation: the organs, grouped by the system each one feeds ─────────────────────────
# `point element organ:<part>` hovers a part (its description and the stats it drives show on the
# right); `click element organ:<part>` raises it by one point of the 25. The grouping and the code
# behind it are in NOTES.md.
mark creation
clip creation_overview
cursor rest
hold 10
clip end creation_overview

# The walk goes region by region in the order the screen lists them, so the narration follows the eye.
# Each hold is about as long as what is said over it: the footage keeps moving while the voice speaks.

# ── The encephalon: thinking and memory ──
mark organs_encephalon
clip organs_encephalon
point element organ:anamnesis
hold 14
click element organ:anamnesis
hold 4
point element organ:cerebellum
hold 8
click element organ:cerebellum
click element organ:cerebellum
hold 3
point element organ:cerebrum
hold 5
click element organ:cerebrum
click element organ:cerebrum
hold 3
point element organ:hippocampus
hold 6
point element organ:pineal_gland
hold 10
clip end organs_encephalon

# ── The visage: senses and speech ──
mark organs_visage
clip organs_visage
point element organ:left_ear
hold 7
click element organ:left_ear
click element organ:right_ear
hold 3
point element organ:left_eye
hold 6
point element organ:nose
hold 10
point element organ:tongue
hold 10
click element organ:tongue
click element organ:tongue
hold 3
point element organ:teeths
hold 12
clip end organs_visage

# ── The trunk: strength, life and the humors ──
mark organs_trunk
clip organs_trunk
point element organ:backbone
hold 8
click element organ:backbone
click element organ:backbone
click element organ:backbone
hold 3
point element organ:heart
hold 12
click element organ:heart
click element organ:heart
click element organ:heart
click element organ:heart
hold 3
point element organ:pulmones
hold 16
point element organ:viscera
hold 8
click element organ:viscera
click element organ:viscera
click element organ:viscera
click element organ:viscera
hold 4
point element organ:paunch
hold 3
point element organ:genitories
hold 4
click element organ:genitories
hold 2
point element organ:spleen
hold 2
point element organ:hepar
hold 12
clip end organs_trunk

# ── The upper limbs ──
mark organs_upper
clip organs_upper
point element organ:right_hand
hold 9
click element organ:right_hand
click element organ:right_hand
hold 3
point element organ:left_hand
hold 4
point element organ:right_arm
hold 5
clip end organs_upper

# ── The lower limbs ──
mark organs_lower
clip organs_lower
point element organ:left_foot
hold 7
point element organ:left_leg
hold 8
click element organ:left_leg
click element organ:right_leg
hold 4
cursor rest
hold 4
clip end organs_lower


click continue
wait mode ChildhoodReminescence 900

# ── Childhood: five memories, remembered for real ───────────────────────────────────────────────────
# Each reminescence observes only the fragment --childhood-path names for it, and its keyword is
# clicked by that fragment (`@name`), not by the word the model happened to write.
#   1. sobs                                   → the port city
#   2. the sound of waves and smell of sweat  → work on the docks
#   3. something sharp                        → a short sword (the WEAPON)
#   4. dream of a golden arch                 → the traveller's backpack, bread and cheese inside (the CONSUMABLE)
#   5. shelter                                → no item (exploration, endurance); the phase ends
# No fragment on this path grants footwear (the stable, farm and castle fragments do).
mark childhood
clip childhood_1
advance 12 900
cursor rest
hold 8
click keyword @sobs
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 8
click button
clip end childhood_1

clip childhood_2
advance 12 900
cursor rest
hold 8
click keyword @waves
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 8
click button
clip end childhood_2

clip childhood_3
advance 12 900
cursor rest
hold 8
click keyword @sharp
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 8
click button
clip end childhood_3

clip childhood_4
advance 12 900
cursor rest
hold 8
click keyword @golden
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 8
click button
clip end childhood_4

clip childhood_5
advance 12 900
cursor rest
hold 8
click keyword @shelter
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 20 900
cursor rest
hold 8
click button
clip end childhood_5

# ── Get up ───────────────────────────────────────────────────────────────────────────────────────────
# One six on the dice gets the body up. A failing roll is turned with voluptas from the hepar.
wait mode GetUp 900
mark get_up
clip get_up
advance 12 900
cursor rest
hold 6
click keyword 0
choose 0
choose 0
advance 12 900
hold 2
click action 0
choose 0
advance 12 900
dice
hold 2
click humor hepar needed
click die needed
click humor spleen needed
click die needed
click humor pulmones needed
click die needed
click humor paunch needed
click die needed
click humor hepar needed
click die needed
hold 2
click continue
advance 20 900
cursor rest
hold 8
click button
wait mode WorldView 900
clip end get_up

# ── A run begins ─────────────────────────────────────────────────────────────────────────────────────
mark run_start
clip run_start
cursor rest
hold 10
clip end run_start
quit
