# Custom additions for this project
# Do not ignore Debug/ folders inside src/ (e.g. Nodes/Debug/)
!src/**/[Dd]ebug/

# AI Models (keeping models directory but ignoring large model files)
models/*.gguf
models/*.bin
models/*.safetensors
models/llama-*
models/embeddings/
catalyst-models/

# The llama.cpp runtime: ~185 MB of third-party binaries across two toolchains, replaced
# wholesale on an upgrade. Note "models/llama-*" above does NOT cover models/llama itself — it
# matches models/llama-old and models/llama-arm64. The documentation files are kept, since they
# are what says which build to fetch and how to add a GPU backend to it.
models/llama/*
!models/llama/BUILD.txt
!models/llama/backends/
models/llama/backends/*
!models/llama/backends/README.md

# Same again for the native ARM64 toolchain, which "models/llama-*" above would otherwise swallow
# whole — including its BUILD.txt. Losing that would leave the two toolchains asymmetric: the x64
# one recording which upstream build to fetch and the ARM64 one recording nothing, which is the
# harder of the two to reconstruct because its build number differs (b8746 against b8851).
!models/llama-arm64/
models/llama-arm64/*
!models/llama-arm64/BUILD.txt

# The pre-cleanup models folder, kept locally as an archive (see models/README.md).
models_old/

# Release packages built by package.ps1 — a staged copy of the game plus a multi-GB zip.
dist/

# The single per-run log (GameLog). Replaced on every launch; never worth committing.
log.txt

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# Claude Code: the skill and the slash command are shared; the permission
# allow-list is per-machine and per-user.
.claude/settings.local.json

# The manual's PDF is a build artifact: `python tools/build_manual.py` remakes it
# from docs/manual/*.md, and it is rewritten whole on every build. Delete these two
# lines if you would rather ship the typeset copy from the repo.
docs/manual/*.pdf
docs/manual/_html/

# Throwaway save files written by the cli/system/save_*.cli and death_*.cli scripts, which pass
# --save-path so a scripted run never touches the player's real save.
.tmp-cli-save/

# `[Rr]elease/` and `[Rr]eleases/` above are the Visual Studio template's build-output rules,
# and both match by directory NAME at any depth - so they also swallowed the release skill and
# its changelogs, which are source. Git never descends into an ignored directory, so the
# re-inclusion has to name the directory itself; a negation on the files inside it does nothing.
!.claude/skills/release/
!changelog/

# Crash reports. `CrashReport.WriteReport` preserves the run's log as
# `log-crash-<timestamp>.txt` in the working directory, so a bad week leaves a dozen of them
# in the repo root. They are a copy of log.txt (already ignored above) at the moment of the
# failure — worth reading, never worth committing.
log-crash-*.txt

# The audit CSVs. `--mm-grant-csv` and `--mm-reach-csv` default to these two paths at the repo
# root, and both are regenerated whole from the verb and modus mentis classes. See the `audits`
# skill for the commands.
mm_grants.csv
mm_reachability.csv

# The pre-microworld archive: the old Microworld.cs and its CSVs, kept locally for reference
# the way models_old/ is. Nothing in the build reads it.
DEPRECATED/

# Local scratch. Reference art dropped in to look at, one-off patch scripts already applied,
# installers and anything else that wants to live beside the repo without being part of it.
# Git never descends into it, so nothing inside needs its own rule.
local/
